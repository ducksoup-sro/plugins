        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="DuckSoup.API" Version="2.3.3-RELEASE" />
      <PackageReference Include="DuckSoup.Database" Version="2.3.0-RELEASE" />
      <PackageReference Include="DuckSoup.PacketLibrary" Version="2.2.2-RELEASE" />
    </ItemGroup>

    <ItemGroup>
      <None Update="plugin.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
